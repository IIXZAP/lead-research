APP_NAME="Lead Research Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lead_platform
DB_USERNAME=lead_platform
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production once served over HTTPS — false here so local
# HTTP-only dev (no TLS-terminating proxy) still gets a working session.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lead-platform.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Internal API (Laravel <-> Python research service) ---
RESEARCH_AGENT_BASE_URL=http://python-api:8000
INTERNAL_SHARED_SECRET=change-me-in-production
INTERNAL_SIGNATURE_TTL_SECONDS=300
# Where Python sends callbacks — the Docker network hostname (nginx service),
# never APP_URL/localhost, since that's only reachable from your browser,
# not from another container.
INTERNAL_CALLBACK_BASE_URL=http://nginx

# --- CORS (only relevant if a separately-hosted frontend calls /api/campaigns) ---
# Comma-separated exact origins, e.g. https://app.example.com,https://admin.example.com
# Never set this to a wildcard — supports_credentials is true in config/cors.php.
CORS_ALLOWED_ORIGINS=

# --- SerpApi (Python service reads these too, kept here for reference) ---
RESEARCH_PROVIDER=mock
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_TIMEOUT_SECONDS=30
SERPAPI_MAX_RETRIES=3

# --- Cost / quota control ---
MAX_SERPAPI_REQUESTS_PER_CAMPAIGN=50
MAX_LEADS_PER_CAMPAIGN=500
SERPAPI_CACHE_TTL_HOURS=24

# --- Website audit ---
WEBSITE_AUDIT_CONCURRENCY=5
WEBSITE_AUDIT_TIMEOUT_SECONDS=15
WEBSITE_AUDIT_MAX_LINKS=20

VITE_APP_NAME="${APP_NAME}"
