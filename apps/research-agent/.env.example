APP_ENV=local

REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_DB=2
CELERY_RESULT_DB=3

INTERNAL_SHARED_SECRET=change-me-in-production
INTERNAL_SIGNATURE_TTL_SECONDS=300

RESEARCH_PROVIDER=mock
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_TIMEOUT_SECONDS=30
SERPAPI_MAX_RETRIES=3

MAX_SERPAPI_REQUESTS_PER_CAMPAIGN=50
MAX_LEADS_PER_CAMPAIGN=500
SERPAPI_CACHE_TTL_HOURS=24

WEBSITE_AUDIT_CONCURRENCY=5
WEBSITE_AUDIT_TIMEOUT_SECONDS=15
WEBSITE_AUDIT_MAX_LINKS=20
WEBSITE_AUDIT_SLOW_THRESHOLD_MS=3000
WEBSITE_AUDIT_USER_AGENT="LeadResearchBot/1.0 (+contact@yourcompany.example)"
WEBSITE_AUDIT_USE_PLAYWRIGHT=false
