# Values here are consumed by docker-compose.yml itself (ports, DB bootstrap
# credentials for the mysql container). Laravel reads apps/web/.env and the
# research agent reads apps/research-agent/.env — copy those too (make install
# does this for you).

APP_PORT=8080
PYTHON_API_PORT=8000
DB_FORWARD_PORT=3306
REDIS_FORWARD_PORT=6379

DB_DATABASE=lead_platform
DB_USERNAME=lead_platform
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
